DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5000
CORS_ORIGIN="http://localhost:5173"

# Used ONLY on the very first `npm run seed` run to create the admin account.
# After the admin row exists these values are ignored completely.
# To change the email later, use: npm run admin:set-email -- new@example.com
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# SMTP for the forgot-password code. If SMTP_HOST is empty, the code is printed in the server console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Portfolio <no-reply@example.com>"
