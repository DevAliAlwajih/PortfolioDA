DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5000
CORS_ORIGIN="http://localhost:5173"

# First admin account, created by `npm run seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# SMTP for the forgot-password code. If SMTP_HOST is empty, the code is printed in the server console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Portfolio <no-reply@example.com>"
