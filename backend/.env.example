DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Used ONLY on the very first `npm run seed` run to create the admin account.
# After the admin row exists these values are ignored completely.
# To change the email later, use: npm run admin:set-email -- new@example.com
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# SMTP – required in production (the server refuses to start without it).
# In development, emails are printed to the console instead.
#
# Gmail example (use an App Password, not your real Gmail password):
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords and create an app password
#   3. Fill in the values below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Portfolio <you@gmail.com>"
